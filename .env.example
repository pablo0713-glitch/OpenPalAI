# =============================================================
# Model Provider
# Options: anthropic | openai | openrouter | gemini | grok | ollama | lm_studio
# =============================================================
MODEL_PROVIDER=anthropic

# === Anthropic (Claude) ===
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048              # Minimum 2048 — values below this cause silent empty responses

# === OpenAI ===
# https://platform.openai.com
# Set MODEL_PROVIDER=openai
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4o

# === OpenRouter ===
# https://openrouter.ai — access many models through one key
# Set MODEL_PROVIDER=openrouter
#OPENAI_API_KEY=sk-or-...
#OPENAI_MODEL=anthropic/claude-sonnet-4-5

# === Google Gemini (OpenAI-compatible endpoint) ===
# https://aistudio.google.com/apikey
# Set MODEL_PROVIDER=gemini
#OPENAI_API_KEY=AIza...
#OPENAI_MODEL=gemini-2.0-flash

# === Grok (xAI) ===
# https://console.x.ai
# Set MODEL_PROVIDER=grok
#OPENAI_API_KEY=xai-...
#OPENAI_MODEL=grok-3

# === Ollama (local) ===
# https://ollama.com — run models locally, no API key required
# Set MODEL_PROVIDER=ollama
#OLLAMA_BASE_URL=http://localhost:11434/v1
#OLLAMA_MODEL=llama3.2

# === LM Studio (local) ===
# https://lmstudio.ai — run models locally via LM Studio's built-in server
# Set MODEL_PROVIDER=lm_studio
#OPENAI_BASE_URL=http://localhost:1234/v1
#OPENAI_MODEL=llama-3.2-3b-instruct

# =============================================================
# Discord
# =============================================================
DISCORD_TOKEN=
DISCORD_ALLOWED_GUILD_IDS=          # Comma-separated snowflakes, empty = all guilds
DISCORD_ACTIVE_CHANNEL_IDS=         # Channels where bot responds without @mention

# =============================================================
# Second Life — HTTP Bridge
# =============================================================
SL_BRIDGE_URL=                      # Public HTTPS URL (cloudflared or other tunnel)
SL_BRIDGE_HOST=0.0.0.0
SL_BRIDGE_PORT=8080
SL_BRIDGE_SECRET=change_this_to_a_long_random_string
SL_TRIGGER_NAMES=Trixxie,Trix,Trixx # Comma-separated — must match TRIGGER_NAMES in LSL/Lua script

# =============================================================
# Web Search
# =============================================================
# Provider options: serper | brave
# Serper: https://serper.dev — 2,500 free searches/month
# Brave:  https://api.search.brave.com
SEARCH_PROVIDER=serper
SEARCH_API_KEY=

# =============================================================
# Rate Limiting
# =============================================================
RATE_LIMIT_CAPACITY=5               # Token bucket size per user
RATE_LIMIT_REFILL_RATE=0.5          # Tokens per second (1 req per 2s sustained)

# =============================================================
# Memory
# =============================================================
MEMORY_DIR=./data/memory
NOTES_DIR=./data/notes
MEMORY_MAX_HISTORY=20               # Max conversation turns kept per channel
OWNER_SL_NAME=                      # Your Second Life avatar name
OWNER_DISCORD_NAME=                 # Your Discord username

# =============================================================
# Library System
# =============================================================
LIBRARY_DIR=./data/library          # Directory for situational library modules (.md files)
LIBRARY_ALWAYS_ON_CAP=4000          # Max chars of always-on library content injected per message

# =============================================================
# Memory Pipeline — Importance Scoring & Consolidation
# =============================================================
IMPORTANCE_THRESHOLD=0.4            # Turns scored >= this are included in consolidation (0.0–1.0)
IMPORTANCE_SCORE_BATCH_SIZE=20      # Turns scored per curator API call

# =============================================================
# Proactive Recall (optional feature)
# =============================================================
# When true, a lightweight pre-flight check runs before each reply to decide
# whether session_search should run automatically. Adds one small API call per message.
# PROACTIVE_RECALL=false
