-- ================================================================
-- Trixxie — Friendly Companion Agent — Cool VL Viewer Automation Script
-- ================================================================
-- Place this file at: <viewer>/user_settings/automation.lua
--
-- SETUP:
--   1. Set SERVER_URL to your bridge's public HTTPS base URL (no trailing slash)
--      Same value as SERVER_URL in the LSL HUD — e.g. https://your-tunnel.trycloudflare.com
--   2. Set SECRET to match SL_BRIDGE_SECRET in your .env (or leave empty)
--   3. Set GRID to "opensim" if running on OpenSimulator
-- ================================================================

-- --- Config ---
local SERVER_URL    = "YOUR_TUNNEL_URL"
local SECRET        = "YOUR_BRIDGE_SECRET"
local GRID          = "sl"       -- "sl" or "opensim"
local IM_CHUNK_SIZE = 1000       -- max chars per SendIM call
local CHAT_BUF_SIZE = 10         -- ambient chat lines to buffer
local TRIGGER_NAMES = {"Primary", "Alias1", "Alias2"} -- names/aliases that trigger a local chat response

-- --- Sensor Intervals ---
local TICK_SECS     = 30.0       -- Base timer delay (in seconds)
local AV_TICKS      = 2          -- avatar scan every 2 ticks (60s)
local ENV_TICKS     = 20         -- env scan every 20 ticks (600s)
local CHAT_TICKS    = 3          -- chat flush every 3 ticks (90s)
local RLV_TICKS     = 1          -- RLV state every 1 tick (30s)

-- --- State ---
local pending_ims  = {}   -- [handle] = {session_id, origin_id}
local sent_replies = {}   -- [text] = pending echo count — echo suppression
local nearby_chat  = {}   -- rolling buffer of local chat
local tick_count   = 0    -- main thread loop tick counter


-- ================================================================
-- Helpers
-- ================================================================

-- Split text into chunks of at most IM_CHUNK_SIZE chars, breaking at the last
-- sentence boundary (". ", "! ", "? ", "\n") in the second half of the chunk.
local function split_chunks(text)
    local chunks = {}
    local start  = 1
    local len    = string.len(text)

    while start <= len do
        local finish = start + IM_CHUNK_SIZE - 1
        if finish >= len then
            chunks[#chunks + 1] = string.sub(text, start)
            break
        end

        -- Try to break at a sentence boundary in the back half of the chunk.
        local boundary = nil
        local half     = start + math.floor(IM_CHUNK_SIZE / 2)
        local window   = string.sub(text, half, finish)

        -- Search right-to-left for ". ", "! ", "? ", "\n"
        for _, sep in ipairs({". ", "! ", "? ", "\n"}) do
            local pos = 1
            local last_found = nil
            while true do
                local s, e = string.find(window, sep, pos, true)
                if not s then break end
                last_found = half + s - 1  -- map back to full-string position
                pos = e + 1
            end
            if last_found and (not boundary or last_found > boundary) then
                boundary = last_found + string.len(sep) - 1
            end
        end

        if boundary then
            chunks[#chunks + 1] = string.sub(text, start, boundary)
            start = boundary + 1
        else
            chunks[#chunks + 1] = string.sub(text, start, finish)
            start = finish + 1
        end
    end

    return chunks
end

-- Deliver a (potentially long) reply as successive SendIM or SendChat calls.
local function send_chunked(session_id, text, is_local)
    local chunks = split_chunks(text)
    for _, chunk in ipairs(chunks) do
        sent_replies[chunk] = (sent_replies[chunk] or 0) + 1
        if is_local then
            SendChat(chunk)
        else
            SendIM(session_id, chunk)
        end
    end
end


local scan_clothing -- forward declaration

-- ================================================================
-- OnInstantMsg — fires on every received IM
-- type == 0 : peer-to-peer (private IM)
-- ================================================================
function OnInstantMsg(session_id, origin_id, msg_type, name, text)
    -- Only handle peer-to-peer IMs.
    if msg_type ~= 0 then return end

    -- Ignore messages sent by this avatar (Trixxie herself).
    local self_info = GetAgentInfo()
    if self_info and origin_id == self_info["id"] then return end

    -- Suppress echo: Cool VL Viewer reflects sent IMs back through OnInstantMsg
    -- with the recipient's origin_id rather than the sender's, bypassing the
    -- self-check above. Consume one pending echo count for this text, if any.
    if sent_replies[text] and sent_replies[text] > 0 then
        sent_replies[text] = sent_replies[text] - 1
        if sent_replies[text] == 0 then sent_replies[text] = nil end
        return
    end

    -- Build the POST payload.
    local region = ""
    local grid_info = GetGridSimAndPos()
    if grid_info then
        region = grid_info["region"] or ""
    end

    -- Chat context is delivered via the HUD's sensor pipeline (/sl/sensor type="chat"),
    -- not piggybacked on this request. The HUD must be worn and running.
    local payload = {
        user_id      = origin_id,
        display_name = name,
        message      = text,
        region       = region,
        channel      = 42,
        grid         = GRID,
        client       = "lua",
    }

    -- Include secret in body (PostHTTP does not support custom headers).
    if SECRET and SECRET ~= "" then
        payload["secret"] = SECRET
    end

    local body = EncodeJSON(payload)

    -- Show typing indicator, fire async POST, stash handle → session mapping.
    SetAgentTyping(true)
    local handle = PostHTTP(SERVER_URL .. "/sl/message", body, 60, "application/json", "application/json")
    pending_ims[handle] = {session_id = session_id, origin_id = origin_id}
end


-- ================================================================
-- OnHTTPReply — fires when PostHTTP completes
-- ================================================================
function OnHTTPReply(handle, success, reply)
    local ctx = pending_ims[handle]
    if not ctx then return end

    -- Always clear the typing indicator and the pending entry.
    SetAgentTyping(false)
    pending_ims[handle] = nil

    if not success then
        SendIM(ctx.session_id, "*Something went sideways on my end. Try again in a moment.*")
        return
    end

    local data = DecodeJSON(reply)
    if not data then
        SendIM(ctx.session_id, "*I got a garbled reply from my brain. Try again.*")
        return
    end

    -- Deliver direct reply text (chunked to respect 1023-char IM limit).
    local reply_text = data["reply"] or ""
    if reply_text ~= "" then
        send_chunked(ctx.session_id, reply_text, ctx.is_local)
    end

    -- Deliver any action lines (im / emote / mute / unmute).
    local raw_actions = data["actions"]
    -- CoolVL's DecodeJSON unwraps single-element JSON arrays into the object itself.
    -- Normalize to an ipairs-compatible list regardless of how many actions there are.
    local action_list = {}
    if type(raw_actions) == "table" then
        if raw_actions["action_type"] ~= nil then
            -- Single action was decoded as a plain object (array wrapper stripped).
            action_list[1] = raw_actions
        else
            -- Multiple actions: try 0-based first, then 1-based.
            local i = 0
            while raw_actions[i] ~= nil do
                action_list[#action_list + 1] = raw_actions[i]
                i = i + 1
            end
            if #action_list == 0 then
                i = 1
                while raw_actions[i] ~= nil do
                    action_list[#action_list + 1] = raw_actions[i]
                    i = i + 1
                end
            end
        end
    end
    print("OnHTTPReply: processing " .. tostring(#action_list) .. " action(s)")
    if #action_list > 0 then
        for idx, action in ipairs(action_list) do
            local atype = action["action_type"] or "im"
            local atext = action["text"] or ""
            print("OnHTTPReply: action[" .. tostring(idx) .. "] type=" .. atype .. " text=" .. atext)
            if atype == "mute_avatar" then
                -- type=1 (avatar by Id) requires UUID, not display name.
                local uuid = action["target_key"] or ctx.origin_id or ""
                local label = action["text"] or uuid
                print("OnHTTPReply: calling AddMute uuid=" .. uuid)
                if uuid ~= "" then AddMute(uuid, 1) end
                print("OnHTTPReply: AddMute returned")
            elseif atype == "unmute_avatar" then
                local uuid = action["target_key"] or ctx.origin_id or ""
                local label = action["text"] or uuid
                print("OnHTTPReply: calling RemoveMute uuid=" .. uuid)
                if uuid ~= "" then RemoveMute(uuid, 1) end
                print("OnHTTPReply: RemoveMute returned")
            elseif atype == "is_muted" then
                local uuid = action["target_key"] or ctx.origin_id or ""
                local label = action["text"] or uuid
                print("OnHTTPReply: calling IsMuted uuid=" .. uuid)
                if uuid ~= "" then
                    local muted = IsMuted(uuid, 1)
                    print("OnHTTPReply: IsMuted=" .. tostring(muted))
                    SendIM(ctx.session_id, label .. " is " .. (muted and "muted" or "not muted"))
                end
            elseif atype == "scan_outfit" then
                scan_clothing()
            elseif atext ~= "" then
                if atype == "emote" then
                    -- Wrap in asterisks if not already.
                    if string.sub(atext, 1, 1) ~= "*" then
                        atext = "*" .. atext .. "*"
                    end
                end
                if ctx.is_local and (atype == "say" or atype == "emote") then
                    SendChat(atext)
                else
                    SendIM(ctx.session_id, atext)
                end
            end
        end
    else
        print("OnHTTPReply: actions field is nil/absent in response")
    end
end


-- ================================================================
-- Native Sensor Functions (POST to /sl/sensor)
-- ================================================================

local function sensor_post(stype, data)
    local payload = {
        type    = stype,
        user_id = GetAgentInfo()["id"],
        data    = data
    }
    
    local grid_info = GetGridSimAndPos()
    payload.region = grid_info and grid_info.region or ""
    
    if SECRET and SECRET ~= "" then
        payload.secret = SECRET
    end
    
    local body = EncodeJSON(payload)
    -- Fire and forget POST
    PostHTTP(SERVER_URL .. "/sl/sensor", body, 15, "application/json", "application/json")
end

local function scan_avatars()
    local radar_uuids = GetRadarList()
    local avatars = {}
    local max = 25
    local my_pos = GetGridSimAndPos()
    if not my_pos then return end
    
    local mx, my = my_pos.x, my_pos.y

    for _, uuid in ipairs(radar_uuids) do
        local av_data = GetRadarData(uuid)
        if av_data and av_data.position and av_data.id ~= GetAgentInfo().id then
            local dx = av_data.position.x - mx
            local dy = av_data.position.y - my
            local dz = av_data.position.z - my_pos.z
            local dist = math.sqrt(dx*dx + dy*dy + dz*dz)
            
            table.insert(avatars, {
                distance = math.floor(dist * 10) / 10.0,
                key      = uuid,
                name     = av_data.name
            })
        end
    end
    
    -- sort and trim to max
    table.sort(avatars, function(a, b) return a.distance < b.distance end)
    local trimmed = {}
    for i=1, math.min(#avatars, max) do
        table.insert(trimmed, avatars[i])
    end
    
    if #trimmed > 0 then
        sensor_post("avatars", trimmed)
    end
end

local function scan_environment()
    local grid_info = GetGridSimAndPos()
    local parcel_info = GetParcelInfo()
    local env_data = {
        region       = grid_info and grid_info.region or "",
        rating       = "", -- Sim rating unavailable directly via lua without LSL bridge
        time_of_day  = "12:00", -- Viewer does not expose native EEP time easily
        sun_altitude = 1.0,
        avatar_count = #(GetRadarList() or {})
    }
    
    if parcel_info then
        env_data.parcel      = parcel_info.name or ""
        -- truncate desc
        local desc = parcel_info.desc or ""
        if string.len(desc) > 400 then desc = string.sub(desc, 1, 399) end
        env_data.parcel_desc = string.gsub(desc, "\r*$", "")
    end
    
    sensor_post("environment", env_data)
end

local function scan_rlv()
    local info = GetAgentInfo()
    local is_sitting, is_flying = false, false
    
    if info then
        if info.sitting or info.sitting_on_ground then is_sitting = true end
        if info.flying then is_flying = true end
    end
    
    local rlv_data = {
        sitting     = is_sitting,
        on_object   = is_sitting, -- no easy way to discern ground vs object via just lua sitting flag right now
        sitting_on  = "",
        autopilot   = false,
        flying      = is_flying,
        teleported  = false,
        position    = {0,0,0}
    }
    
    local p = GetGridSimAndPos()
    if p then
        rlv_data.position = { math.floor(p.x*10)/10, math.floor(p.y*10)/10, math.floor(p.z*10)/10 }
    end
    
    sensor_post("rlv", rlv_data)
end

local function flush_chat()
    if #nearby_chat == 0 then return end
    sensor_post("chat", nearby_chat)
    -- Clear buffer since we only want to submit new messages each time
    nearby_chat = {}
end

scan_clothing = function()
    local attach = GetAgentAttachments()
    local layers = GetAgentWearables()
    
    local attach_csv = ""
    local layers_csv = ""
    
    if attach then
        local names = {}
        for _, itm in ipairs(attach) do table.insert(names, itm.name or "obj") end
        attach_csv = table.concat(names, ", ")
    end
    if layers then
        local names = {}
        for _, itm in ipairs(layers) do table.insert(names, itm.name or "layer") end
        layers_csv = table.concat(names, ", ")
    end
    
    local clothing_data = {
        attachments = attach_csv,
        layers      = layers_csv
    }
    sensor_post("clothing", clothing_data)
end


-- ================================================================
-- Local Chat Events
-- ================================================================

-- Check if any string inside triggers list is inside the message
local function is_triggered(msg)
    local msg_lower = string.lower(msg)
    for _, trigger in ipairs(TRIGGER_NAMES) do
        if string.find(msg_lower, string.lower(trigger), 1, true) then
            return true
        end
    end
    return false
end

function OnReceivedChat(msg_type, from_id, is_avatar, name, text)
    -- Filter out system/debug/typing info we don't want buffered.
    if text == "" or not is_avatar then return end
    
    -- Exclude our own messages from triggering ourselves, but buffer them.
    local info = GetAgentInfo()
    local self_id = info and info.id
    
    local raw = name .. ": " .. text
    if string.len(raw) > 200 then raw = string.sub(raw, 1, 199) end
    
    -- Buffer for sensor context
    table.insert(nearby_chat, raw)
    if #nearby_chat > CHAT_BUF_SIZE then
        table.remove(nearby_chat, 1)
    end
    
    -- Name trigger: respond if TRIGGER_NAME appears in message
    if (not self_id or from_id ~= self_id) and is_triggered(text) then
        local region = ""
        local grid_info = GetGridSimAndPos()
        if grid_info then region = grid_info.region or "" end

        local payload = {
            user_id      = from_id,
            display_name = name,
            message      = text,
            region       = region,
            channel      = 0,
            grid         = GRID,
            client       = "lua",
        }

        if SECRET and SECRET ~= "" then
            payload.secret = SECRET
        end

        local body = EncodeJSON(payload)
        -- Route to the same IM HTTP handler for ease of chunking the replies
        local handle = PostHTTP(SERVER_URL .. "/sl/message", body, 60, "application/json", "application/json")
        -- we pretend the session id is zero
        pending_ims[handle] = {session_id = from_id, origin_id = from_id, is_local=true}
    end
end

-- ================================================================
-- Thread and Subsystems Init
-- ================================================================

function OnChangedParcel()
    scan_environment()
end

ThreadRun("companion_sensor_loop", function()
    -- Initial startup tasks
    scan_clothing()
    SendChat("/42 LUA_MODE ON")
    
    while true do
        Sleep(TICK_SECS * 1000)
        tick_count = tick_count + 1
        
        if tick_count % AV_TICKS == 0 then scan_avatars() end
        if tick_count % ENV_TICKS == 0 then scan_environment() end
        if tick_count % CHAT_TICKS == 0 then flush_chat() end
        if tick_count % RLV_TICKS == 0 then scan_rlv() end
    end
end)
